{
  "private": true,
  "name": "react-template",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "vite --host",
    "check": "tsgo --noEmit --incremental -p .",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest --no-coverage --no-watch",
    "test:ui": "vitest --no-coverage --ui",
    "lint": "biome ci .",
    "lint:fix": "biome check --fix .",
    "clean": "rimraf dist node_modules/.vite node_modules/.vite-temp",
    "clean:all": "rimraf dist node_modules"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "0.562.0",
    "motion": "^12.27.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "shadcn": "^4.2.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "wouter": "^3.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@tsconfig/vite-react": "^7.0.2",
    "@types/node": "^24.1.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "latest",
    "@vitest/ui": "^4.0.17",
    "happy-dom": "^20.3.3",
    "rimraf": "^6.1.2",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  }
}
