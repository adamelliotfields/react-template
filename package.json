{
  "private": true,
  "name": "react-template",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "vite --host",
    "check": "tsc -p .",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest --no-coverage --no-watch",
    "test:coverage": "vitest --coverage --no-watch",
    "lint": "biome ci .",
    "lint:fix": "biome check --fix .",
    "clean": "rimraf dist node_modules/.vite node_modules/.vite-temp",
    "clean:all": "rimraf dist node_modules"
  },
  "dependencies": {
    "@tailwindcss/typography": "~0.5",
    "class-variance-authority": "~0.7",
    "clsx": "^2",
    "lucide-react": "^1",
    "radix-ui": "^1",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4",
    "tailwind-merge": "^3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1",
    "wouter": "^3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@tailwindcss/vite": "^4",
    "@tsconfig/vite-react": "^8",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "@vitest/coverage-v8": "^4.1.11",
    "happy-dom": "^20",
    "rimraf": "^6",
    "typescript": "^7",
    "vite": "^8",
    "vitest": "^4"
  }
}
